<!DOCTYPE html>
<html lang="en" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register - SPROUT</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">
    <div th:include="fragments/navbar :: navbar"></div>

    <div class="container mx-auto py-16 px-4">
        <h1 class="text-3xl font-bold text-center mb-2">Create an Account</h1>
        <p class="text-center text-gray-600 mb-10">Tell us who you are to get started</p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-2xl mx-auto">
            <a href="/farmerRegister" class="bg-white rounded-lg shadow-md hover:shadow-xl transition p-8 text-center">
                <div class="text-5xl mb-3">🌾</div>
                <h2 class="text-xl font-bold mb-1">I'm a Farmer</h2>
                <p class="text-sm text-gray-500">Register to book cane pickups and track deliveries</p>
            </a>
            <a href="/workerRegister" class="bg-white rounded-lg shadow-md hover:shadow-xl transition p-8 text-center">
                <div class="text-5xl mb-3">👷</div>
                <h2 class="text-xl font-bold mb-1">I'm a Worker</h2>
                <p class="text-sm text-gray-500">Register as staff for a factory department</p>
            </a>
        </div>

        <p class="text-center text-gray-600 mt-10">Already have an account? <a href="/login" class="text-green-700 font-semibold hover:underline">Log in</a></p>
    </div>

    <div th:include="fragments/footer :: footer"></div>
</body>
</html>